---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CTASection from '../components/CTASection.astro';
import { SEO_PAGES } from '../data/seoPages';

export interface Props {
  article: CollectionEntry<'blog'>;
  relatedArticles?: CollectionEntry<'blog'>[];
}

const { article, relatedArticles = [] } = Astro.props;
const {
  title,
  description,
  publishedAt,
  updatedAt,
  author,
  category,
  tags,
  featuredImage,
  relatedSeoPage,
} = article.data;

const formattedPublished = new Date(publishedAt).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updatedAt
  ? new Date(updatedAt).toLocaleDateString('id-ID', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const breadcrumbs = [
  { name: 'Artikel', href: '/artikel/' },
  { name: title, href: `/artikel/${article.slug}/` },
];

const schemaCrumbs = breadcrumbs.map((c) => ({
  name: c.name,
  item: c.href,
}));

// Check if there is a linked SEO landing page for internal linking
const seoPageData = relatedSeoPage ? SEO_PAGES[relatedSeoPage] : null;
---

<BaseLayout
  title={`${title} | Sewa Mobil Matic BSD`}
  description={description}
  type="article"
  image={featuredImage}
  publishedTime={new Date(publishedAt).toISOString()}
  modifiedTime={updatedAt ? new Date(updatedAt).toISOString() : undefined}
  author={author}
  breadcrumbs={schemaCrumbs}
>
  <Breadcrumb items={breadcrumbs} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    
    <!-- Article Header -->
    <header class="space-y-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-600/20 text-blue-400 text-xs font-bold border border-blue-500/30">
        {category}
      </div>
      
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {title}
      </h1>

      <div class="flex items-center justify-center gap-4 text-xs sm:text-sm text-slate-400 pt-2 border-b border-slate-800 pb-6">
        <span>Oleh <strong class="text-slate-200">{author}</strong></span>
        <span>•</span>
        <time datetime={new Date(publishedAt).toISOString()}>Dipublikasikan: {formattedPublished}</time>
        {formattedUpdated && (
          <>
            <span>•</span>
            <span>Diperbarui: {formattedUpdated}</span>
          </>
        )}
      </div>
    </header>

    <!-- Featured Image -->
    <div class="rounded-2xl overflow-hidden bg-slate-900 border border-slate-800 shadow-2xl aspect-[16/9]">
      <img
        src={featuredImage}
        alt={title}
        width="1200"
        height="675"
        loading="eager"
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Article Content Body -->
    <div class="prose prose-invert prose-blue max-w-none text-slate-300 text-base sm:text-lg leading-relaxed space-y-6">
      <slot />
    </div>

    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="pt-6 border-t border-slate-800 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-2">Tags:</span>
        {tags.map((tag) => (
          <span class="px-3 py-1 rounded-lg bg-slate-900 text-slate-300 text-xs font-medium border border-slate-800">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Related SEO Landing Page Banner (Internal Linking) -->
    {seoPageData && (
      <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-900/60 to-slate-900 border border-blue-500/40 space-y-3">
        <span class="text-xs font-bold text-blue-400 uppercase tracking-wider block">Layanan Terkait:</span>
        <h3 class="text-xl font-extrabold text-white">{seoPageData.h1}</h3>
        <p class="text-sm text-slate-300">{seoPageData.intro}</p>
        <div class="pt-2">
          <a
            href={`/${seoPageData.slug}/`}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm shadow-md transition-colors"
          >
            <span>Lihat Info Layanan {seoPageData.targetKeyword}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    )}

  </article>

  <!-- Related Articles Section -->
  {relatedArticles.length > 0 && (
    <section class="py-14 bg-slate-900 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <h2 class="text-2xl font-extrabold text-white tracking-tight text-center sm:text-left">
          Artikel &amp; Panduan Terkait Lainnya
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedArticles.map((rel) => (
            <ArticleCard article={rel} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <CTASection waMessage={`Halo Sewa Mobil Matic, saya membaca artikel "${title}" dan tertarik sewa mobil.`} />
</BaseLayout>
