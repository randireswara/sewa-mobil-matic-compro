---
import { siteConfig } from '../config/site';

export interface Crumb {
  name: string;
  href: string;
}

export interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const allCrumbs = [
  { name: 'Home', href: '/' },
  ...items
];
---

<nav aria-label="Breadcrumb" class="py-3 px-4 bg-slate-900/60 backdrop-blur border-b border-slate-800 text-xs sm:text-sm">
  <div class="max-w-7xl mx-auto flex items-center flex-wrap gap-2 text-slate-400">
    {allCrumbs.map((crumb, index) => {
      const isLast = index === allCrumbs.length - 1;
      return (
        <div class="flex items-center gap-2">
          {index > 0 && (
            <svg class="w-3.5 h-3.5 text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
          {isLast ? (
            <span class="text-blue-400 font-semibold truncate max-w-[200px] sm:max-w-xs" aria-current="page">
              {crumb.name}
            </span>
          ) : (
            <a href={crumb.href} class="hover:text-white transition-colors">
              {crumb.name}
            </a>
          )}
        </div>
      );
    })}
  </div>
</nav>
