---
import { TERMS_AND_CONDITIONS, type PricingItem } from "../data/rentalPricing";
import { siteConfig } from "../config/site";

interface Props {
  title: string;
  durationLabel: string;
  items: PricingItem[];
}

const { title, durationLabel, items } = Astro.props;
---

<div class="space-y-8">
  <!-- Table Container -->
  <div
    class="bg-slate-900 rounded-2xl sm:rounded-3xl border border-slate-800 overflow-hidden shadow-2xl"
  >
    <div
      class="p-5 sm:p-6 bg-slate-950 border-b border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
    >
      <div>
        <h2 class="text-lg sm:text-xl font-extrabold text-white tracking-tight">
          {title}
        </h2>
        <p class="text-xs text-slate-400 mt-0.5">
          Pilihan armada matic terawat &amp; siap jalan - sewamobilmatic.id
        </p>
      </div>
      <span
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-600/20 text-blue-400 text-xs font-bold border border-blue-500/30"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
        Paket {durationLabel}
      </span>
    </div>

    <!-- Responsive 2-Column Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300">
        <thead
          class="bg-slate-950/90 text-xs uppercase font-extrabold text-slate-400 border-b border-slate-800 tracking-wider"
        >
          <tr>
            <th scope="col" class="px-5 sm:px-8 py-4 w-3/5 sm:w-2/3">
              Jenis Kendaraan
            </th>
            <th scope="col" class="px-5 sm:px-8 py-4 w-2/5 sm:w-1/3 text-right">
              Harga Sewa
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/80">
          {
            items.map((item, idx) => {
              const waText = encodeURIComponent(
                `Halo sewamobilmatic.id, saya ingin menanyakan ketersediaan dan reservasi sewa ${durationLabel.toLowerCase()} untuk unit *${item.vehicle}* (${item.price}). Apakah unit masih tersedia?`,
              );
              const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waText}`;
              const isCallAdmin = item.price.toLowerCase().includes("admin");

              return (
                <tr
                  class={`transition-colors hover:bg-slate-800/50 ${idx % 2 === 0 ? "bg-slate-900/40" : "bg-slate-900/90"}`}
                >
                  <td class="px-5 sm:px-8 py-4">
                    <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-3">
                      <span class="font-bold text-white text-sm sm:text-base">
                        {item.vehicle}
                      </span>
                      {item.category && (
                        <span class="self-start sm:self-center px-2 py-0.5 rounded-md bg-slate-800 text-slate-400 text-[11px] font-medium border border-slate-700/60">
                          {item.category}
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-5 sm:px-8 py-4 text-right">
                    <div class="flex flex-col items-end gap-1">
                      <span
                        class={`font-extrabold text-sm sm:text-base ${isCallAdmin ? "text-amber-400" : "text-emerald-400"}`}
                      >
                        {item.price}
                      </span>
                      <a
                        href={waUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-[11px] text-emerald-400 hover:text-emerald-300 font-bold border border-emerald-500/20 transition-all"
                        aria-label={`Booking ${item.vehicle} via WhatsApp`}
                      >
                        <img
                          src="/images/whatsapp.webp"
                          alt="WhatsApp"
                          class="w-3.5 h-3.5 object-contain shrink-0"
                          width="14"
                          height="14"
                        />
                        <span>Pesan Unit</span>
                      </a>
                    </div>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Syarat dan Ketentuan (Notes) Section Right Below Table -->
  <div
    class="p-6 sm:p-7 rounded-2xl sm:rounded-3xl bg-slate-900/90 border border-slate-800 space-y-4 shadow-xl"
  >
    <div class="flex items-center gap-2.5 pb-3 border-b border-slate-800">
      <div
        class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center shrink-0"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path>
        </svg>
      </div>
      <h3 class="text-base sm:text-lg font-bold text-white">
        Syarat dan Ketentuan
      </h3>
    </div>

    <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300 leading-relaxed">
      {
        TERMS_AND_CONDITIONS.map((term) => (
          <li class="flex items-start gap-3">
            <svg
              class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"
              />
            </svg>
            <span>{term}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
