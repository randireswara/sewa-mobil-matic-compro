---
interface Props {
  currentType: "harian" | "mingguan" | "bulanan";
}

const { currentType } = Astro.props;

const allOptions = [
  {
    type: "harian",
    title: "Harga Sewa Mobil Harian - sewamobilmatic.id",
    shortTitle: "Sewa Mobil Harian",
    href: "/sewa-mobil-harian/",
    desc: "Layanan sewa mobil matic per 24 jam untuk keperluan dinas singkat, acara keluarga, atau liburan praktis.",
    badge: "Mulai Rp 400.000 / 24 Jam",
    icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
  {
    type: "mingguan",
    title: "Harga Sewa Mobil Mingguan - sewamobilmatic.id",
    shortTitle: "Sewa Mobil Mingguan",
    href: "/sewa-mobil-mingguan/",
    desc: "Paket sewa hemat 7 hari penuh dengan tarif lebih terjangkau dibanding hitungan harian akumulatif.",
    badge: "Mulai Rp 2.100.000 / Minggu",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    type: "bulanan",
    title: "Harga Sewa Mobil Bulanan - sewamobilmatic.id",
    shortTitle: "Sewa Mobil Bulanan",
    href: "/sewa-mobil-bulanan/",
    desc: "Paket bulanan paling efisien untuk individu & perusahaan, bebas biaya perawatan, ganti oli, & pajak.",
    badge: "Mulai Rp 5.500.000 / Bulan",
    icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
  },
];

const otherLinks = allOptions.filter((opt) => opt.type !== currentType);
---

<section class="mt-12 pt-8 border-t border-slate-800 space-y-6">
  <div class="space-y-1">
    <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">
      Pilihan Durasi Sewa Lainnya
    </span>
    <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
      Lihat Pilihan Sewa Lainnya - sewamobilmatic.id
    </h2>
    <p class="text-xs sm:text-sm text-slate-400">
      Temukan paket durasi rental yang paling sesuai dengan rencana mobilitas
      dan anggaran perjalanan Anda.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      otherLinks.map((link) => (
        <a
          href={link.href}
          class="group p-6 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-blue-500/50 transition-all duration-300 hover:-translate-y-1 shadow-xl flex flex-col justify-between space-y-4"
          title={link.title}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="w-10 h-10 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors">
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={link.icon}
                  />
                </svg>
              </div>
              <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-bold border border-emerald-500/20">
                {link.badge}
              </span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition-colors">
                {link.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-400 mt-1.5 leading-relaxed">
                {link.desc}
              </p>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-bold text-blue-400 group-hover:text-blue-300">
            <span>Lihat Pricelist {link.shortTitle}</span>
            <svg
              class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </div>
        </a>
      ))
    }
  </div>
</section>
