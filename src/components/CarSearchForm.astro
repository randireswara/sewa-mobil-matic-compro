---
import { siteConfig } from "../config/site";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class={`relative rounded-3xl bg-slate-900/90 backdrop-blur-md border border-slate-700/80 p-6 sm:p-7 shadow-2xl space-y-5 text-left transition-all ${className}`}
  id="car-search-container"
>
  <!-- Card Header -->
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span
          class="text-xs font-extrabold text-blue-400 uppercase tracking-wider"
        >
          Reservasi Cepat
        </span>
      </div>
      <h3 class="text-xl font-bold text-white tracking-tight">
        Cari Mobil Matic
      </h3>
    </div>
    <span
      class="px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 text-xs font-bold border border-blue-500/20"
    >
      Semua Unit Prima
    </span>
  </div>

  <form id="hero-car-search-form" class="space-y-4">
    <!-- Tanggal Mulai Sewa -->
    <div>
      <label
        for="search-start-date"
        class="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5"
      >
        <svg
          class="w-4 h-4 text-blue-400 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        <span>Tanggal Mulai Sewa</span>
      </label>
      <input
        type="date"
        id="search-start-date"
        name="startDate"
        required
        class="w-full bg-slate-950/90 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all cursor-pointer"
        style="color-scheme: dark;"
      />
    </div>

    <!-- Tanggal Selesai Sewa -->
    <div>
      <label
        for="search-end-date"
        class="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5"
      >
        <svg
          class="w-4 h-4 text-blue-400 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        <span>Tanggal Selesai Sewa</span>
      </label>
      <input
        type="date"
        id="search-end-date"
        name="endDate"
        required
        class="w-full bg-slate-950/90 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all cursor-pointer"
        style="color-scheme: dark;"
      />
    </div>

    <!-- Pickup Location -->
    <div>
      <label
        for="search-pickup-location"
        class="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5"
      >
        <svg
          class="w-4 h-4 text-blue-400 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span>Pickup Location (Lokasi Antar/Jemput)</span>
      </label>
      <div class="relative">
        <select
          id="search-pickup-location"
          name="pickupLocation"
          required
          class="w-full bg-slate-950/90 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all cursor-pointer appearance-none pr-10"
        >
          <option value="BSD City (Gratis Antar)"
            >BSD City (Gratis Antar-Jemput)</option
          >
          <option value="Gading Serpong">Gading Serpong</option>
          <option value="Alam Sutera">Alam Sutera</option>
          <option value="Bintaro Jaya">Bintaro Jaya</option>
          <option value="Tangerang Selatan (Pamulang / Ciputat / Serpong)"
            >Tangerang Selatan (Pamulang/Ciputat/Serpong)</option
          >
          <option value="Tangerang Kota / Karawaci"
            >Tangerang Kota / Karawaci</option
          >
          <option value="Bandara Soekarno-Hatta (CGK)"
            >Bandara Soekarno-Hatta (CGK)</option
          >
          <option value="Jakarta Selatan">Jakarta Selatan</option>
          <option value="Jakarta Barat">Jakarta Barat</option>
          <option value="Lokasi Lainnya di Jabodetabek"
            >Lokasi Lainnya di Jabodetabek</option
          >
        </select>
        <div
          class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-400"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Tombol Submit -->
    <div class="pt-2">
      <button
        type="submit"
        class="w-full group flex items-center justify-center gap-2.5 py-3.5 px-5 rounded-xl bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-bold text-sm sm:text-base shadow-lg shadow-blue-600/30 hover:shadow-blue-600/50 transition-all cursor-pointer transform hover:-translate-y-0.5 active:translate-y-0"
      >
        <svg
          class="w-5 h-5 text-white group-hover:scale-110 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span>Cari Armada Mobil</span>
        <svg
          class="w-4 h-4 text-blue-200 group-hover:translate-x-1 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </button>
    </div>
  </form>

  <!-- Value Badges -->
  <div
    class="pt-1 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400"
  >
    <span class="flex items-center gap-1">
      <svg
        class="w-3.5 h-3.5 text-emerald-400 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M5 13l4 4L19 7"></path>
      </svg>
      100% Matic Prima
    </span>
    <span class="flex items-center gap-1">
      <svg
        class="w-3.5 h-3.5 text-emerald-400 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M5 13l4 4L19 7"></path>
      </svg>
      Gratis Antar BSD
    </span>
    <span class="flex items-center gap-1">
      <svg
        class="w-3.5 h-3.5 text-emerald-400 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M5 13l4 4L19 7"></path>
      </svg>
      Unit Higienis
    </span>
  </div>
</div>

<script define:vars={{ waNumber: siteConfig.whatsappNumber }}>
  function initCarSearch() {
    const form = document.getElementById("hero-car-search-form");
    const startInput = document.getElementById("search-start-date");
    const endInput = document.getElementById("search-end-date");
    const locationInput = document.getElementById("search-pickup-location");

    if (!form || !startInput || !endInput || !locationInput) return;
    if (form.dataset.initialized) return;
    form.dataset.initialized = "true";

    // Set default dates: Start = tomorrow, End = 3 days later
    const today = new Date();
    const formatDate = (date) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    };

    const formatIndonesianDate = (dateStr) => {
      if (!dateStr) return "";
      const [year, month, day] = dateStr.split("-");
      const months = [
        "Januari",
        "Februari",
        "Maret",
        "April",
        "Mei",
        "Juni",
        "Juli",
        "Agustus",
        "September",
        "Oktober",
        "November",
        "Desember",
      ];
      return `${parseInt(day, 10)} ${months[parseInt(month, 10) - 1]} ${year}`;
    };

    const minDateStr = formatDate(today);
    startInput.min = minDateStr;
    endInput.min = minDateStr;

    // Tomorrow as default start
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);
    const endDefault = new Date(tomorrow);
    endDefault.setDate(endDefault.getDate() + 2);

    startInput.value = formatDate(tomorrow);
    endInput.value = formatDate(endDefault);

    // Sync end date min when start date changes
    startInput.addEventListener("change", () => {
      if (startInput.value) {
        endInput.min = startInput.value;
        if (endInput.value && endInput.value < startInput.value) {
          endInput.value = startInput.value;
        }
      }
    });

    // Handle search submission
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const startDateVal = startInput.value;
      const endDateVal = endInput.value;
      const locationVal = locationInput.value;

      if (!startDateVal || !endDateVal) return;

      // Calculate duration in days
      const d1 = new Date(startDateVal);
      const d2 = new Date(endDateVal);
      const diffTime = Math.abs(d2 - d1);
      const diffDays = Math.max(1, Math.ceil(diffTime / (1000 * 60 * 60 * 24)));

      const formattedStart = formatIndonesianDate(startDateVal);
      const formattedEnd = formatIndonesianDate(endDateVal);

      // 1. Update the Search Result Banner at Armada Section
      const searchBanner = document.getElementById("armada-search-banner");
      const searchDetails = document.getElementById("armada-search-details");

      if (searchBanner && searchDetails) {
        searchBanner.classList.remove("hidden");
        searchDetails.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-4 p-4 sm:p-5 rounded-2xl bg-blue-950/70 border border-blue-500/40 text-left shadow-xl shadow-blue-500/5">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500 text-slate-950 font-bold text-xs">✓</span>
                <span class="font-bold text-white text-sm sm:text-base">Menampilkan Seluruh Armada Siap Sewa (${diffDays} Hari)</span>
                <span class="px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-300 text-xs font-semibold">Tersedia</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-300">
                <strong class="text-blue-300">Jadwal:</strong> ${formattedStart} s/d ${formattedEnd} &bull; 
                <strong class="text-blue-300">Lokasi Penjemputan:</strong> ${locationVal}
              </p>
            </div>
            <button 
              type="button"
              id="btn-reset-search" 
              class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 border border-slate-700 transition-colors cursor-pointer"
            >
              Ubah Pencarian
            </button>
          </div>
        `;

        // Handle reset / change search
        const resetBtn = document.getElementById("btn-reset-search");
        if (resetBtn) {
          resetBtn.addEventListener("click", () => {
            const heroSection = document.querySelector("section");
            if (heroSection) {
              heroSection.scrollIntoView({ behavior: "smooth" });
            }
          });
        }
      }

      // 2. Customize WhatsApp buttons on every vehicle card
      const vehicleCards = document.querySelectorAll("[data-vehicle-card]");
      vehicleCards.forEach((card) => {
        const carName = card.getAttribute("data-vehicle-name") || "Mobil Matic";
        const waBtn = card.querySelector('a[href*="wa.me"]');
        if (waBtn) {
          const customMsg = `Halo Sewa Mobil Matic, saya ingin menyewa unit *${carName}* untuk jadwal tanggal *${formattedStart} s/d ${formattedEnd}* (${diffDays} hari) dengan penjemputan di *${locationVal}*. Apakah unit ini masih tersedia?`;
          waBtn.setAttribute(
            "href",
            `https://wa.me/${waNumber}?text=${encodeURIComponent(customMsg)}`,
          );
        }
      });

      // 3. Smooth scroll to the armada section
      const armadaSection = document.getElementById("armada");
      if (armadaSection) {
        const yOffset = -70; // offset for sticky header
        const y =
          armadaSection.getBoundingClientRect().top +
          window.pageYOffset +
          yOffset;
        window.scrollTo({ top: y, behavior: "smooth" });

        // Visual feedback pulse
        armadaSection.classList.add(
          "ring-2",
          "ring-blue-500/50",
          "transition-all",
          "duration-700",
        );
        setTimeout(() => {
          armadaSection.classList.remove("ring-2", "ring-blue-500/50");
        }, 2000);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCarSearch);
  } else {
    initCarSearch();
  }
  document.addEventListener("astro:page-load", initCarSearch);
</script>
